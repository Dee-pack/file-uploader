<%- include('partials/header', { title: file.name }) %>
    <div class="page-head">
        <% if (file.folder) { %>
            <a class="muted" href="/folders/<%= file.folder.id %>">&larr; Back to <%= file.folder.name %></a>
            <% } else { %>
                <a class="muted" href="/upload">&larr; Back to files</a>
                <% } %>
                    <h1 style="overflow-wrap:anywhere">
                        <%= file.name %>
                    </h1>
    </div>
    <% if (error) { %>
        <div class="alert alert-error">
            <%= error %>
        </div>
        <% } %>

            <section class="card">
                <div class="table-wrap">
                    <table>
                        <tr>
                            <th>Size</th>
                            <td>
                                <%= formatBytes(file.size) %>
                            </td>
                        </tr>
                        <tr>
                            <th>Type</th>
                            <td>
                                <%= file.mimeType %>
                            </td>
                        </tr>
                        <tr>
                            <th>Uploaded</th>
                            <td><time class="local-time" datetime="<%= file.uploadedAt.toISOString() %>">
                                    <%= file.uploadedAt.toISOString() %>
                                </time></td>
                        </tr>
                        <tr>
                            <th>Folder</th>
                            <td>
                                <%= file.folder ? file.folder.name : "None" %>
                            </td>
                        </tr>
                    </table>
                </div>
                <p><a class="btn btn-primary" href="/files/<%= file.id %>/download">Download</a></p>
            </section>

            <section class="card">
                <h2>Move file</h2>
                <form class="inline-form" action="/files/<%= file.id %>/move" method="POST">
                    <select name="folderId" aria-label="Destination folder">
                        <option value="" <%=file.folderId===null ? "selected" : "" %>>No folder</option>
                        <% folders.forEach((f)=> { %>
                            <option value="<%= f.id %>" <%=file.folderId===f.id ? "selected" : "" %>><%= f.name %>
                            </option>
                            <% }) %>
                    </select>
                    <button class="btn">Move</button>
                </form>
            </section>

            <section class="card">
                <h2>Danger zone</h2>
                <form action="/files/<%= file.id %>/delete" method="POST" data-confirm="Delete this file permanently?">
                    <button class="btn btn-danger">Delete file</button>
                </form>
            </section>
            <%- include('partials/footer') %>