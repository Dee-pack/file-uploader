<%- include('partials/header', { title: folder.name }) %>
    <div class="page-head">
        <a class="muted" href="/folders">&larr; All folders</a>
        <h1>📁 <%= folder.name %>
        </h1>
    </div>
    <%- include('partials/errors') %>

        <section class="card">
            <h2>Upload a file</h2>
            <%- include('partials/upload-form', { action: "/folders/" + folder.id + "/upload" }) %>
        </section>

        <section class="card">
            <h2>Files</h2>
            <%- include('partials/file-list', { files }) %>
        </section>

        <section class="card">
            <h2>Share this folder</h2>
            <p class="muted">Anyone with the link can view and download everything in this folder until it expires.</p>
            <form class="inline-form" action="/folders/<%= folder.id %>/share" method="POST">
                <select name="duration" aria-label="Link duration">
                    <% durations.forEach((d)=> { %><option value="<%= d %>">Lasts <%= d %>
                        </option>
                        <% }) %>
                </select>
                <button class="btn btn-primary">Create share link</button>
            </form>
            <% shares.forEach((s)=> { %>
                <div class="share-row">
                    <input id="share-<%= s.id %>" type="text" readonly value="<%= baseUrl %>/share/<%= s.id %>" />
                    <button type="button" class="btn" data-copy="#share-<%= s.id %>">Copy</button>
                    <form action="/folders/<%= folder.id %>/shares/<%= s.id %>/revoke" method="POST"
                        data-confirm="Revoke this link? It will stop working immediately.">
                        <button class="btn btn-ghost btn-danger-text">Revoke</button>
                    </form>
                    <span class="muted">expires <time class="local-time" datetime="<%= s.expiresAt.toISOString() %>">
                            <%= s.expiresAt.toISOString() %>
                        </time></span>
                </div>
                <% }) %>
        </section>

        <section class="card">
            <h2>Folder settings</h2>
            <form class="inline-form" action="/folders/<%= folder.id %>/rename" method="POST">
                <input type="text" name="name" value="<%= folder.name %>" maxlength="50" required />
                <button class="btn">Rename</button>
            </form>
            <hr style="border:0;border-top:1px solid var(--border);margin:1rem 0" />
            <form action="/folders/<%= folder.id %>/delete" method="POST"
                data-confirm="Delete this folder and all its files? This can't be undone.">
                <button class="btn btn-danger">Delete folder</button>
            </form>
        </section>
        <%- include('partials/footer') %>