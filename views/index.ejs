<h1>File Uploader</h1>
<% if (currentUser) { %>
  <p>Signed in as <%= currentUser.email %>
  </p>
  <a href="/folders">My folders</a>
  <a href="/upload">Upload files</a>
  <form action="/logout" method="POST"><button>Log out</button></form>
  <% } else { %>
    <a href="/login">Log in</a> | <a href="/sign-up">Sign up</a>
    <% } %>